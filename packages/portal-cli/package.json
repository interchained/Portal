{
  "name": "@interchained/portal-cli",
  "version": "0.1.6",
  "description": "Portal CLI — dev, build, audit, improve, generate, guard",
  "license": "GPL-3.0-or-later",
  "author": "Interchained <dev@interchained.org>",
  "type": "module",
  "bin": {
    "portal": "./dist/index.js"
  },
