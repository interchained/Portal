    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "execa": "^8.0.1",
    "vite": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
